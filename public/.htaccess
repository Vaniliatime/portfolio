# ---------------------------------------------------------------------------
# kkaszuba.eu — Apache config for the static export (SEOHOST).
# Ships inside out/ and is uploaded together with the rest of the build.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Drop the www prefix.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ---- Language landing -----------------------------------------------------
  # The bare domain has no page of its own; send Polish browsers to /pl/ and
  # everyone else to /en/.
  RewriteCond %{HTTP:Accept-Language} ^pl [NC]
  RewriteRule ^$ /pl/ [R=302,L]
  RewriteRule ^$ /en/ [R=302,L]

  # ---- Redirects from the previous site --------------------------------------
  # Old paths were unprefixed and English-only.
  RewriteRule ^projects/2d-arts/?$ /en/work/2d-arts/ [R=301,L]
  RewriteRule ^projects/rigs/?$ /en/work/pc-builds/ [R=301,L]
  RewriteRule ^projects/?$ /en/work/ [R=301,L]
  RewriteRule ^resume/?$ /en/resume/ [R=301,L]
  RewriteRule ^contact/sent/?$ /en/contact/ [R=301,L]
  RewriteRule ^contact/?$ /en/contact/ [R=301,L]

  # ---- Clean URLs ------------------------------------------------------------
  # trailingSlash: true means every route is a directory with an index.html,
  # which Apache resolves on its own. Only map the .html fallback.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ---- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ---- Caching ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build assets are safe to cache hard.
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # HTML must revalidate so deploys are picked up immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
